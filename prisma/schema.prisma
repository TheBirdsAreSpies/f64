// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  password          String
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  posts    Post[]
  apiKeys  ApiKey[]
  logs     Log[]
  roles    Role[]
  photos   Photo[]
  albums   Album[]
  comments Comment[]
  likes    Like[]
}

model Post {
  id        String  @id @default(cuid())
  title     String
  content   String? @db.Text
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String
}

model Album {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  slug         String   @unique
  visibility   String   @default("public") // public, private, password
  password     String?
  coverPhotoId String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String?

  creator    User    @relation(fields: [createdBy], references: [id])
  coverPhoto Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id])
  photos     Photo[] @relation("PhotoAlbums")
  tags       Tag[]

  @@index([visibility])
  @@index([createdAt])
}

model Photo {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  filename      String
  originalPath  String
  thumbnailPath String
  width         Int?
  height        Int?
  fileSize      Int?
  mimeType      String?
  colorSpace    String?
  exifData      String?   @db.Text // JSON string with all EXIF data
  cameraMake    String?
  cameraModel   String?
  exposureTime  Float?
  fNumber       Float?
  iso           Int?
  focalLength   Float?
  lensModel     String?
  sortOrder     Int       @default(0)
  visibility    String    @default("public") // public, private
  isFavorite    Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  uploadedAt    DateTime  @default(now())
  takenAt       DateTime?
  updatedAt     DateTime  @updatedAt
  uploadedBy    String

  uploader    User      @relation(fields: [uploadedBy], references: [id])
  albums      Album[]   @relation("PhotoAlbums")
  albumCovers Album[]   @relation("AlbumCover")
  tags        Tag[]
  comments    Comment[]
  likes       Like[]

  @@index([uploadedAt])
  @@index([visibility])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())

  photos Photo[]
  albums Album[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  photoId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([photoId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([photoId, userId])
  @@index([photoId])
  @@index([userId])
}

model Theme {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(false)
  variables String   @db.Text // JSON string of CSS variables
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  key       String    @unique
  userId    String
  createdAt DateTime  @default(now())
  validTo   DateTime?
  isActive  Boolean   @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdBy   String
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  users       User[]
  permissions Permission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdBy   String
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  roles Role[]
}
